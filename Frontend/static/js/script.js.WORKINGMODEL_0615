    // Ctrl/Cmd + D to download code
    if ((e.ctrlKey || e.metaKey) && e.key === 'd') {
        e.preventDefault();
        if (generatedScripts.length > 0) {
            // Download all test codes
            generatedScripts.forEach((script, index) => {
                downloadTestCode(index);
            });
        } else {
            downloadCode();
        }
    }

    // Escape to close toast
    if (e.key === 'Escape') {
        hideToast();
    }
});

