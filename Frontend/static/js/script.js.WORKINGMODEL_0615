document.addEventListener('keydown', function(e) {
    // Ctrl/Cmd + S to save code
    if ((e.ctrlKey || e.metaKey) && e.key === 's') {
        e.preventDefault();
        if (generatedScripts.length > 0) {
            // Save all test codes
            generatedScripts.forEach((script, index) => {
                saveTestCode(index);
            });
