/* Print styles */
@media print {
    .header,
    .sidebar,
    .buttons,
    .report-buttons,
    .progress-container,
    .toast,
    .test-area-actions,
    .code-actions {
        display: none !important;
    }

    .main-content {
        margin: 0;
        padding: 0;
    }

    .dashboard-container {
        box-shadow: none;
        border: 1px solid #ccc;
        background: white;
        max-width: none;
    }

    .test-area-group {
        page-break-inside: avoid;
        margin-bottom: 20px;
        border: 2px solid #000;
    }

    .test-area-header {
        background: #1e40af !important;
        -webkit-print-color-adjust: exact;
        color-adjust: exact;
        color: white !important;
    }

    .test-area-textarea {
        background: white !important;
        color: #000 !important;
        border: 1px solid #ccc;
    }

    .welcome-message {
        border: 1px solid #ccc;
    }

    .upload-area {
        border: 2px solid #000;
    }
}

    /* High contrast mode support */
    @media (prefers-contrast: high) {
        .test-area-group {
            border-width: 3px;
            border-color: #000;
        }

        .test-area-header {
            background: #000 !important;
            color: #fff !important;
        }

    .test-area-textarea {
        border: 2px solid #000;
    }

    .toast {
        border: 2px solid #000;
    }

    .upload-area {
        border-width: 4px;
        border-color: #000;
    }

    .nav-item {
        border-left-width: 6px;
    }

    .nav-item.active {
        border-left-color: #fff;
    }
}

/* Dark mode support */
@media (prefers-color-scheme: dark) {
    .test-area-textarea {
        background: #1f2937;
        color: #f9fafb;
        border-color: #374151;
    }

    .test-area-char-count {
        background: rgba(31, 41, 55, 0.95);
        color: #d1d5db;
        border-color: #374151;
    }

    .char-count {
        background: rgba(31, 41, 55, 0.95);
        color: #d1d5db;
        border-color: #374151;
    }

    .file-preview {
        background: #1f2937;
        border-color: #374151;
    }

    .file-name {
        color: #f9fafb;
    }

    .file-size {
        color: #d1d5db;
    }

    .toast {
        background: #1f2937;
        color: #f9fafb;
    }

    .toast-message {
        color: #f9fafb;
    }

    .loading-content {
        background: #1f2937;
        color: #f9fafb;
    }

    .loading-text {
        color: #f9fafb;
    }
}

/* Reduced motion preferences */
@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
    }

    .progress-spinner {
        animation: none;
    }

    .test-area-header::before {
        animation: none;
    }

    .progress-bar::after {
        animation: none;
    }
}

/* Ensure proper z-index stacking */
.test-area-actions {
    z-index: 20;
}

.test-area-char-count {
    z-index: 15;
}

.code-actions {
    z-index: 10;
}

.progress-container {
    z-index: 100;
}

.toast {
    z-index: 1001;
}

.sidebar {
    z-index: 1000;
}

.header {
    z-index: 999;
}

/* Additional utility classes */
.sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
}

.visually-hidden {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
}

/* Performance optimizations */
.test-area-group,
.upload-area,
.progress-container {
    will-change: transform;
}

/* Enhanced accessibility */
.nav-item:focus-visible,
button:focus-visible,
.action-btn:focus-visible {
    outline: 3px solid #3b82f6;
    outline-offset: 2px;
}

.test-area-textarea:focus-visible,
textarea:focus-visible {
    outline: 3px solid #3b82f6;
    outline-offset: 2px;
}

/* Skip link for accessibility */
.skip-link {
    position: absolute;
    top: -40px;
    left: 6px;
    background: #000;
    color: #fff;
    padding: 8px;
    text-decoration: none;
    z-index: 9999;
}

.skip-link:focus {
    top: 6px;
}